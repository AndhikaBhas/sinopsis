# Database Configuration
DATABASE_URL=postgresql://sinopsis:sinopsis231@10.252.178.61:5432/sinopsis

# RabbitMQ Configuration
RABBITMQ_URL=amqp://sinopsis:sinopsis231@10.252.178.62:5672/sinopsis
RABBIT_MQ_EXCHANGE=sinopsis.pipeline
RABBIT_MQ_INPUT_QUEUE=queue.audio_standardized
RABBIT_MQ_OUTPUT_QUEUE=queue.meeting_transcribed
RABBITMQ_REQUEUE_ON_FAILURE=false

# MinIO Configuration (only required if STORAGE_TYPE="minio")
MINIO_ENDPOINT=http://10.252.178.141:9000
MINIO_USER=sinopsis
MINIO_PASSWORD=sinopsis231
MINIO_BUCKET=sinopsis-audio-standardized


# WhisperX ASR Configuration
ASR_MODEL=tiny
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16
ASR_LANGUAGE=id
ASR_BATCH_SIZE=16

# Force Alignment Configuration
# CUSTOM INDONESIAN SUPPORT: Using Wikidepia wav2vec2 model for Indonesian alignment
# This enables word-level timestamps for Indonesian language using a custom model
FORCE_ALIGN=false   # Enable force alignment with custom Indonesian model
ALIGN_MODEL=Wikidepia/wav2vec2-xls-r-300m-indonesian  # Best Indonesian model (5.046% WER)

# Alternative Indonesian models (comment out the one above and use one of these):
# ALIGN_MODEL=cahya/wav2vec2-large-xlsr-indonesian     # Alternative model (25.86% WER)
# ALIGN_MODEL=auto                                     # Use WhisperX defaults (Indonesian not supported)

# Supported languages for default alignment models:
# en, fr, de, es, it, ja, zh, nl, uk, pt, ar, cs, ru, pl, hu, fi, fa, el, tr, da, he, vi, ko, ur, te, hi, ca, ml, no, nn, sk, sl, hr, ro, eu, gl, ka, lv, tl
# Indonesian (id) now supported via custom model!

MEMORY_CLEANUP_INTERVAL=10  # Force garbage collection every N jobs

# Text Cleaning Configuration
ENABLE_REPETITION_CLEANING=true
CLEANING_MODE=fast
MIN_REPETITION_COUNT=2
MAX_PHRASE_LENGTH=4
CLEANING_SIMILARITY_THRESHOLD=0.85