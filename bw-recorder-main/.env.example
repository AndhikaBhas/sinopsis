DATABASE_URL="postgresql://sinopsis:sinopsis231@10.252.178.61:5432/sinopsis?schema=public"

RABBITMQ_URL=amqp://sinopsis:sinopsis231@10.252.178.62:5672/sinopsis
RABBIT_MQ_EXCHANGE=sinopsis.pipeline
RABBIT_MQ_QUEUE=queue.audio_recorded

# Storage Configuration
# Options: "fs" or "minio"
STORAGE_TYPE=minio

# Connection timeout in milliseconds for storage operations (default: 10000 = 10 seconds)
# This is the timeout for connecting to the storage server, not the total upload time
STORAGE_CONNECTION_TIMEOUT_MS=10000

# Upload Timeout Configuration
# Client-side upload timeout for audio recording (default: 300000 = 5 minutes)
# Should match or exceed NGINX proxy_read_timeout (currently 300s)
VITE_UPLOAD_TIMEOUT_MS=300000

# Backend MinIO upload timeout (default: 600000 = 10 minutes)
# For large files on slow network/storage connections
MINIO_UPLOAD_TIMEOUT_MS=600000

# MinIO Configuration (only required if STORAGE_TYPE="minio")
MINIO_ENDPOINT=http://10.252.178.141:9000
MINIO_USER=sinopsis
MINIO_PASSWORD=sinopsis231
MINIO_BUCKET=sinopsis-audio-raw

# Chunked Recording Configuration
# Enable chunked recording mode (true/false)
VITE_CHUNKED_RECORDING_ENABLED=true
# Minimum chunk length in seconds before silence detection kicks in
VITE_MIN_CHUNK_LENGTH_SECONDS=8
# Silence detection threshold in dBFS (e.g., -45 = -45 dBFS, less sensitive)
VITE_CHUNK_SILENCE_THRESHOLD_DBFS=-40
# Silence duration in seconds to trigger chunk split
VITE_CHUNK_SILENCE_DURATION_SECONDS=3
# Interval in seconds for decreasing silence duration by 0.25s
VITE_CHUNK_SILENCE_DECREMENT_INTERVAL_SECONDS=5

# Audio Recording Configuration
# Preferred audio format - use "webm" for Linux/Debian systems, "mp4" for Windows/Mac, "auto" for smart detection
VITE_PREFERRED_AUDIO_FORMAT=auto
# Enable enhanced echo cancellation and noise suppression (true/false)
VITE_ENHANCED_AUDIO_PROCESSING=true
# Audio quality: "low" (64kbps), "medium" (96kbps), "high" (128kbps)
VITE_AUDIO_QUALITY=medium
# Test audio headers before using format (may cause delay on first recording)
VITE_TEST_AUDIO_HEADERS=false
