# Token Hugging Face (https://huggingface.co/settings/tokens), cukup akses "read".
# Setujui juga syarat model di:
#   https://huggingface.co/pyannote/speaker-diarization-community-1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_xx

# Matikan telemetri pyannote (sudah default di kode; dicantumkan agar eksplisit)
PYANNOTE_METRICS_ENABLED=false
